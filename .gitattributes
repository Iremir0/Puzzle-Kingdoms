* text=auto eol=lf

# Unity YAML: merge with UnityYAMLMerge when configured (see docs/SETUP.md)
*.unity text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset text merge=unityyamlmerge eol=lf
*.mat text merge=unityyamlmerge eol=lf
*.anim text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.psd binary
*.tga binary
*.ogg binary
*.wav binary
*.mp3 binary
*.fbx binary
*.glb binary
*.ttf binary
*.otf binary

# Binary art assets: never diff or normalise line endings
*.fbx binary
*.png binary

# Git LFS (PB-12, D-043): rigged Meshy models and the animation clip file are large (10-13 MB each).
# The older static models in Art/Characters/<Name>/<Name>.fbx stay normal git files.
Assets/_Project/Art/**/*_Rig.fbx filter=lfs diff=lfs merge=lfs -text
Assets/_Project/Art/**/Clips_*.fbx filter=lfs diff=lfs merge=lfs -text
